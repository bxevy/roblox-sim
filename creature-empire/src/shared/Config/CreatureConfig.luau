CreatureConfig.Species = {} :: { [string]: Types.SpeciesDef }
CreatureConfig.Order = {} :: { string }
CreatureConfig.Starters = {} :: { string }
for _, def in list do
	assert(CreatureConfig.Species[def.Id] == nil, `Duplicate species {def.Id}`)
	CreatureConfig.Species[def.Id] = def
	table.insert(CreatureConfig.Order, def.Id)
	if def.Starter then
		table.insert(CreatureConfig.Starters, def.Id)
	end
end

-- Job skill of a species at an evolution stage (stage overrides replace the base value).
function CreatureConfig.Affinity(species: Types.SpeciesDef, stage: number, job: string): number
	local evolution = species.Evolution[stage]
	local override = evolution and evolution.Affinity and evolution.Affinity[job]
	return override or species.JobAffinity[job] or 0
end

-- Experience needed to go from `level` to `level + 1`.
CreatureConfig.MaxLevel = 30
function CreatureConfig.XpToNext(level: number): number
	return math.floor(20 * level ^ 1.35)
end
-- Each level above 1 adds this much to WorkSpeed and Yield multipliers (category "Level").
CreatureConfig.LevelBonus = 0.02

function CreatureConfig.Get(id: string): Types.SpeciesDef?
	return CreatureConfig.Species[id]
end

return CreatureConfig
