-- Species ------------------------------------------------------------------------------

local DEFAULT_STATS = {
	WorkSpeed = 10,
	Yield = 10,
	Capacity = 10,
	EnergyEfficiency = 10,
	Exploration = 10,
	CombatPower = 10,
	DiscoveryChance = 10,
	Luck = 10,
	AbilityStrength = 10,
}

local DEFAULT_IDLE: Types.IdleBehaviour = {
	Personality = "Curious",
	WanderRadius = 10,
	HopHeight = 0.6,
	Speed = 8,
	IdleActions = { "Hop", "Look", "Sniff" },
}

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

-- Fills defaults so each entry below only lists what makes the species distinct.
local function species(def: { [string]: any }): Types.SpeciesDef
	local family = CreatureConfig.Families[def.Family]
	assert(family, `Unknown family {def.Family} for {def.Id}`)

	local stats = table.clone(DEFAULT_STATS)
	for stat, value in def.Stats or {} do
		stats[stat] = value
	end

	local appearance = def.Appearance
	appearance.Footstep = appearance.Footstep or family.Footstep
	if appearance.Particle == nil then
		appearance.Particle = { Color = family.Color, Rate = 2, Kind = family.Particle }
	end

	local idle = table.clone(DEFAULT_IDLE)
	for k, v in def.Idle or {} do
		(idle :: any)[k] = v
	end

	-- Evolution: each stage is bigger, works better (StatBonus, category "Stage"), has a
	-- stronger active ability, can change job skills (StageAffinity) and adds visual
	-- features (StageFeatures). The Unlocks text is generated from those numbers so it
	-- can never promise something that isn't implemented.
	local names = def.StageNames or { def.Name, "Mature " .. def.Name, "Ascended " .. def.Name }
	local stageAffinity = def.StageAffinity or {}
	local stageFeatures = def.StageFeatures or { [2] = { "Aura" }, [3] = { "Aura", "Halo" } }
	local function stage(n: number, scale: number, statBonus: number, abilityMultiplier: number, requirements: any)
		local unlocks = {
			`+{math.floor(statBonus * 100)}% work speed and yield`,
			`{def.Active.Name} is {math.floor((abilityMultiplier - 1) * 100)}% stronger`,
		}
		for job, value in stageAffinity[n] or {} do
			table.insert(unlocks, `{job} skill becomes {math.floor(value * 100)}%`)
		end
		table.insert(unlocks, "A new look")
		return {
			Stage = n,
			Name = names[n],
			ScaleMultiplier = scale,
			StatBonus = statBonus,
			AbilityMultiplier = abilityMultiplier,
			Affinity = stageAffinity[n],
			Features = stageFeatures[n],
			Requirements = requirements,
			Unlocks = unlocks,
		}
	end
	local evolution = {
		{ Stage = 1, Name = names[1], ScaleMultiplier = 1, StatBonus = 0, AbilityMultiplier = 1 },
		stage(2, 1.3, 0.15, 1.5, def.Evolve2 or { { Kind = "Level", Amount = 8 }, { Kind = "Essence", Amount = 40 } }),
		stage(3, 1.6, 0.3, 2, def.Evolve3 or {
			{ Kind = "Level", Amount = 20 },
			{ Kind = "Essence", Amount = 300 },
			{ Kind = "Resource", Target = "RefinedCrystal", Amount = 30 },
		}),
	}

	local key = string.lower(def.Id)
	return {
		Id = def.Id,
		Name = def.Name,
		Family = def.Family,
		Rarity = def.Rarity,
		Description = def.Description,
		Discovery = def.Discovery,
		BaseStats = stats,
		JobAffinity = def.Jobs,
		Active = def.Active,
		Passive = def.Passive,
		Evolution = evolution,
		Mutations = def.Mutations or { "Prismatic", "Ancient" },
		Appearance = appearance,
		-- Sound keys resolve through AssetConfig.Sounds; missing ids play nothing.
		Sounds = { Idle = key .. "_idle", Move = key .. "_move", Work = key .. "_work" },
		Habitat = def.Habitat or "VerdantReach",
		Idle = idle,
		Starter = def.Starter,
		Phase = def.Phase or 99,
	}
end

